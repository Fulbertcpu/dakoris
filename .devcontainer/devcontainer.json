{
  "name": "Dakoris Dev Environment",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dakoris-app",
  "workspaceFolder": "/workspaces/dakoris",

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "xdebug.php-debug"
      ]
    }
  },

  "forwardPorts": [
    8080,
    8081
  ]
}